#!/bin/sh
set -eu

COMPATBSD_VERSION="0.1.0-dev"

print_version() {
    printf 'CompatBSD %s\n' "$COMPATBSD_VERSION"
}

print_help() {
    cat <<'USAGE'
CompatBSD - FreeBSD-native Linux application compatibility controller

Usage:
    compatbsd version
    compatbsd help

Commands:
    version    Print the CompatBSD controller version.
    help       Show this help text.

Milestone 1 is design-only. Runtime creation, mounts, Linuxulator changes,
application installation, and application execution are not implemented.
USAGE
}

main() {
    if [ "$#" -eq 0 ]; then
        print_help
        exit 0
    fi

    command_name=$1
    shift

    case "$command_name" in
        version|--version|-V)
            if [ "$#" -ne 0 ]; then
                printf 'compatbsd: version accepts no arguments\n' >&2
                exit 64
            fi
            print_version
            ;;
        help|--help|-h)
            if [ "$#" -ne 0 ]; then
                printf 'compatbsd: help accepts no arguments\n' >&2
                exit 64
            fi
            print_help
            ;;
        *)
            printf 'compatbsd: unknown command: %s\n' "$command_name" >&2
            printf 'Run "compatbsd help" for usage.\n' >&2
            exit 64
            ;;
    esac
}

main "$@"
