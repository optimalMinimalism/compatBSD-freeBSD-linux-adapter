#!/bin/sh
set -eu

COMPATBSD_VERSION="0.1.0-dev"

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
LIBEXEC_DIR="$PROJECT_ROOT/libexec/compatbsd"

print_version() {
    printf 'CompatBSD %s\n' "$COMPATBSD_VERSION"
}

print_help() {
    cat <<'USAGE'
CompatBSD - FreeBSD-native Linux application compatibility controller

Usage:
    compatbsd version
    compatbsd help
    compatbsd doctor

Commands:
    version    Print the CompatBSD controller version.
    help       Show this help text.
    doctor     Inspect the FreeBSD host and Linuxulator state.

Milestone 2 implements read-only host inspection.

Runtime creation, CompatBSD mounts, runtime bootstrapping, application
installation, and application execution are not implemented yet.
USAGE
}

run_doctor() {
    doctor_module="$LIBEXEC_DIR/doctor"

    if [ ! -r "$doctor_module" ]; then
        printf 'compatbsd: doctor module not found: %s\n' "$doctor_module" >&2
        exit 70
    fi

    . "$doctor_module"
    compatbsd_doctor
}

main() {
    if [ "$#" -eq 0 ]; then
        print_help
        exit 0
    fi

    command_name=$1
    shift

    case "$command_name" in
        version|--version|-V)
            if [ "$#" -ne 0 ]; then
                printf 'compatbsd: version accepts no arguments\n' >&2
                exit 64
            fi
            print_version
            ;;
        help|--help|-h)
            if [ "$#" -ne 0 ]; then
                printf 'compatbsd: help accepts no arguments\n' >&2
                exit 64
            fi
            print_help
            ;;
        doctor)
            if [ "$#" -ne 0 ]; then
                printf 'compatbsd: doctor accepts no arguments\n' >&2
                exit 64
            fi
            run_doctor
            ;;
        *)
            printf 'compatbsd: unknown command: %s\n' "$command_name" >&2
            printf 'Run "compatbsd help" for usage.\n' >&2
            exit 64
            ;;
    esac
}

main "$@"
